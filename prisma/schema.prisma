// AccessMap database schema.
//
// Prateek owns Venue + VenueFeature (search, detail, scoring). The other
// models are included so the schema is coherent for the team; Charles/Brandon
// own their relations (photos, ML, reviews, verifications, auth, activity).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through DATABASE_URL. On Supabase this is the pooler
  // (transaction mode, port 6543 + ?pgbouncer=true), which fits many short-
  // lived serverless connections.
  url = env("DATABASE_URL")
  // Migrations use DIRECT_URL instead. Prisma's migration engine needs a direct
  // session connection for DDL + advisory locks; run over the transaction
  // pooler it hangs, so `migrate deploy` must reach Postgres directly (Supabase
  // session pooler port 5432, no pgbouncer). This var must ALWAYS be set (Prisma
  // errors if a referenced env var is missing) — locally, point it at the same
  // direct/session URL you use for DATABASE_URL. Only migration commands read
  // it; the runtime client and `prisma generate` don't connect through it.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  username     String   @unique
  createdAt    DateTime @default(now())

  reviews Review[]
}

model Venue {
  id                 String   @id @default(uuid())
  name               String
  address            String
  city               String
  state              String
  zipCode            String
  // Optional: map-sourced venues have coordinates, but a contributor can add a
  // venue (or add to an existing one) without pinning a location. Rows without
  // coordinates simply don't appear on the map (see VenueMap) and are excluded
  // from distance search/sort.
  latitude           Float?
  longitude          Float?
  placeId            String?  @unique
  venueType          String
  accessibilityScore Int      @default(0)
  totalReviews       Int      @default(0)
  totalPhotos        Int      @default(0)
  // Denormalized community accessibility-vote tallies. Each review can answer
  // "Was this venue accessible? yes / partial / no"; these counters let the
  // venue's community verdict be derived without loading every review.
  accessYesCount     Int      @default(0)
  accessPartialCount Int      @default(0)
  accessNoCount      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  features VenueFeature[]
  reviews  Review[]
  photos   Photo[]

  @@index([latitude, longitude])
  @@index([city, state])
}

model VenueFeature {
  id                String   @id @default(uuid())
  venueId           String
  venue             Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  featureType       String
  mlDetected        Boolean  @default(false)
  mlConfidence      Float?
  communityVerified Boolean  @default(false)
  verifiedCount     Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())

  @@unique([venueId, featureType])
  @@index([featureType])
}

model Review {
  id           String    @id @default(uuid())
  venueId      String
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  rating       Int
  comment      String
  visitDate    DateTime?
  helpfulCount Int       @default(0)
  // The reviewer's accessibility verdict for this visit: "yes" | "partial" |
  // "no" (nullable — older reviews predate this). Distinct from the star
  // rating, which measures overall experience, not accessibility.
  accessibilityVote String?
  createdAt    DateTime  @default(now())

  @@index([venueId])
}

// --- Charles: photos + ML (Grounding DINO) detection ---

model Photo {
  id           String   @id @default(uuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId       String?
  imageUrl     String
  thumbnailUrl String?
  mlAnalyzed   Boolean  @default(false)
  uploadedAt   DateTime @default(now())

  analysis   MLAnalysis?
  detections Detection[]

  @@index([venueId])
}

model MLAnalysis {
  id              String   @id @default(uuid())
  photoId         String   @unique
  photo           Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  modelVersion    String
  processingTime  Float?
  totalDetections Int      @default(0)
  highConfidence  Int      @default(0)
  analyzedAt      DateTime @default(now())

  detections Detection[]
}

model Detection {
  id                   String     @id @default(uuid())
  photoId              String
  photo                Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  mlAnalysisId         String
  analysis             MLAnalysis @relation(fields: [mlAnalysisId], references: [id], onDelete: Cascade)
  cocoLabel            String
  accessibilityFeature String
  confidence           Float
  boundingBox          Json
  verified             Boolean    @default(false)
  verificationCount    Int        @default(0)

  @@index([photoId])
  @@index([accessibilityFeature])
}
