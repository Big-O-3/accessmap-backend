# Copy to .env for dev, or set these in your host (Render) for prod.

# PostgreSQL connection string.
#   dev:  postgresql://postgres:postgres@localhost:5432/accessmap
#   prod: a Supabase pooler connection string
#         (Supabase → Project Settings → Database → Connection string).
#
# Supabase offers the pooler on two ports, and Prisma needs different settings
# for each. The port decides which — not the hostname, which is identical.
#
#   :5432  Session pooler. One dedicated connection per session, so prepared
#          statements work and no extra params are required. Best for a
#          long-running server (Render web service). Recommended here.
#            ...pooler.supabase.com:5432/postgres
#          Optionally add ?connection_limit=5 to cap the pool per instance, so
#          scaling to several instances can't exhaust Postgres's connection cap.
#
#   :6543  Transaction pooler. Connections are handed out per transaction, so
#          Prisma's named prepared statements can reach a backend that never saw
#          the PREPARE and fail with Postgres 26000. REQUIRES ?pgbouncer=true.
#          Pair it with connection_limit=1 (the pooler does the multiplexing;
#          each process should hold as little as possible):
#            ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# The 6543 failure is load-dependent — one user never trips it, a demo does — so
# server.js warns at boot if the params are missing.
#
# Note: don't run `prisma migrate deploy` through either pooler. Migrations need
# a direct connection (advisory locks + DDL), which is what DIRECT_URL is for
# (wired to `directUrl` in prisma/schema.prisma). See DIRECT_URL below.
DATABASE_URL=

# Direct (non-pooled) PostgreSQL connection, used ONLY by `prisma migrate`
# (schema.prisma's datasource `directUrl`). Migrations take advisory locks and
# run DDL, which the Supabase pooler can't do — so this must bypass the pooler.
# REQUIRED: since directUrl is set in the schema, every `prisma` command errors
# with P1012 ("Environment variable not found: DIRECT_URL") if it's missing.
#   dev:  same value as DATABASE_URL (local Postgres is already direct)
#   prod: Supabase → Settings → Database → Connection string → "Direct
#         connection" (host db.<ref>.supabase.co, port 5432, NOT the pooler).
# On Render this is set as an env var and consumed by the `prisma migrate
# deploy` step in the build command (see render build settings / README).
DIRECT_URL=

# Port the API listens on. Render sets this automatically; leave blank in prod.
PORT=3000

# Your Supabase project URL — the same value the frontend uses for
# VITE_SUPABASE_URL, e.g. https://abcdefgh.supabase.co
#
# requireAuth verifies access tokens against this project's public keys at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Supabase signs with ES256 by
# default now, so this is the setting that matters. Check yours:
#
#     curl -s https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#
# A key listed there means tokens are asymmetric and SUPABASE_URL is required —
# the legacy shared secret cannot verify them, and leaving it as the only
# configured option rejects every login with "Invalid token".
SUPABASE_URL=

# Legacy fallback, only for projects that still sign with the HS256 shared
# secret (Supabase → Settings → API → JWT Settings). If the JWKS call above
# returned {"keys":[]}, this is the one you need. Harmless to leave blank
# otherwise: the algorithm in each token decides which key gets used.
SUPABASE_JWT_SECRET=

# Python ML service (accessmap-ml) that runs Grounding DINO detection.
#   dev:  http://localhost:5001
#   prod (Hugging Face Space):
#     https://<hf-username>-<space-name>.hf.space
#   prod (Render web service):
#     https://accessmap-ml.onrender.com
ML_SERVICE_URL=http://localhost:5001

# Cloudinary image storage. Create a free account at https://cloudinary.com and
# copy these from the dashboard. If left blank, file uploads are disabled and
# the photos route only accepts an imageUrl.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated allowlist of frontend origins the browser will call from.
#   dev:  http://localhost:5173
#   prod: https://accessmap-frontend.onrender.com
# Add every host you want to allow (dev + prod + any preview URLs).
CORS_ORIGINS=http://localhost:5173
